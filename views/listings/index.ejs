<% layout("layouts/boilerplate") -%>

    <body>
        <div id="filters" class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <% listingCategories.forEach((category) => { %>
                <a class="filter d-flex flex-column align-items-center text-center text-decoration-none <%= selectedCategory === category.slug ? 'active' : '' %>" href="/listings?category=<%= category.slug %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" <%= selectedCategory === category.slug ? 'aria-current="page"' : '' %>>
                    <i class="<%= category.icon %>" aria-hidden="true"></i>
                    <span class="mt-1"><%= category.label %></span>
                </a>
            <% }) %>
            <div class="d-flex align-items-center border border-secondary-subtle rounded-pill bg-body-tertiary px-3 py-2">
                <div class="form-check form-switch form-check-reverse">
                    <input type="checkbox" class="form-check-input" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label small text-body-secondary text-nowrap" for="flexSwitchCheckDefault" id="flexSwitchCheckBox">Display total after taxes</label>
                </div>    
            </div>
        </div>
        <br>
        <% if (q || selectedCategory) { %>
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <h1 class="h4 mb-1"><% if (q) { %>Search results for “<%= q %>”<% if (selectedCategory) { %> in <%= selectedCategoryLabel %><% } %><% } else { %><%= selectedCategoryLabel %> stays<% } %></h1>
                    <p class="text-body-secondary mb-0"><%= allListings.length %> stay<%= allListings.length === 1 ? "" : "s" %> found</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm rounded-pill" href="/listings">Clear filters</a>
            </div>
        <% } %>
        <% if (allListings.length === 0) { %>
            <div class="alert alert-light border" role="status">
                <h2 class="h5">No stays found</h2>
                <p class="mb-0"><% if (selectedCategory) { %>Try another category or clear the filters.<% } else { %>Try a different listing name, city, or country.<% } %></p>
            </div>
        <% } else { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                <% for (let listing of allListings) { %>
                    <a href="/listings/<%= listing._id %>" class="col d-block text-decoration-none">
                        <div class="card border-0 mb-4 position-relative">
                            <img src="<%= listing.image.url %>" class="card-img-top w-100 object-fit-cover listing-card-image" alt="<%= listing.title %>">
                            <div class="card-img-overlay"></div>
                            <div class="card-body p-0">
                                <p class="card-text fw-bold">
                                    <b><%= listing.title %></b>
                                </p>
                                <p>
                                    &#8377; <%= listing.price.toLocaleString("en-IN"); %>/ night
                                    <i class="tax-info d-none">&nbsp; &nbsp;+18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } %>
    </body>

    <script>
        let taxSwitch = document.getElementById("flexSwitchCheckDefault")
        taxSwitch.addEventListener("click", () => {
            document.querySelectorAll(".tax-info").forEach((info) => {
                info.classList.toggle("d-none");
            });
        });
    </script>




