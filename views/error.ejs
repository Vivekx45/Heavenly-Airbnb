<% layout("/layouts/boilerplate") -%>

    <div class="row mt-3">
        <div class="alert alert-danger col-10 col-md-8 offset-1 offset-md-2" role="alert">
            <h1 class="h4 alert-heading">We couldn't complete that request</h1>
            <p class="mb-2"><%= err.message || "Something went wrong. Please try again." %></p>
            <p class="small text-body-secondary">Error <%= err.statusCode || 500 %></p>
            <a class="btn btn-outline-dark btn-sm" href="/listings">Back to stays</a>
        </div>
    </div>
