<% layout("layouts/boilerplate") -%>

<main class="container py-4 py-md-5">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 42rem;">
        <div class="card-body p-4 p-md-5">
            <p class="text-danger fw-semibold mb-2">Administrator tools</p>
            <h1 class="h3 mb-2">Edit review</h1>
            <p class="text-body-secondary mb-4">For <a href="/listings/<%= listing._id %>"><%= listing.title %></a></p>

            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="review-rating">Rating</label>
                    <select class="form-select" id="review-rating" name="review[rating]" required>
                        <% for (let rating = 5; rating >= 1; rating--) { %>
                            <option value="<%= rating %>" <%= review.rating === rating ? "selected" : "" %>><%= rating %> star<%= rating === 1 ? "" : "s" %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="review-comment">Comment</label>
                    <textarea class="form-control" id="review-comment" name="review[comment]" rows="6" minlength="3" maxlength="1200" required><%= review.comment %></textarea>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-danger" type="submit">Save review</button>
                    <a class="btn btn-outline-secondary" href="/listings/<%= listing._id %>">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>
